#sum h1{font-size:36px;border-bottom:3px solid #111;padding-bottom:6px}
#sum h2{font-size:22px;margin:16px 0 4px}#sum small{font:400 14px Barlow,sans-serif;color:#444}
#sum ul{margin:4px 0;padding-left:20px}#sum li{margin:2px 0}#sum p{margin:2px 0}
.tb{display:flex;gap:8px;max-width:640px;margin:0 auto 12px}.tb button{flex:1;padding:12px;border:2px solid #111;background:#fff;color:#111;border-radius:8px;font:800 18px "Barlow Condensed",sans-serif}
@media print{main,.tb,#info{display:none!important}#sum{position:static;overflow:visible}}
</style>
</head>
<body>
<main>
<h1>Q-in-a-Pocket</h1>
<p class="sub">Plan the beatdown. Keep time.</p>
<nav role="tablist"><button role="tab" id="t-plan" aria-selected="true">Plan</button><button role="tab" id="t-timer" aria-selected="false">Timer</button><button role="tab" id="t-dir" aria-selected="false">Directory</button></nav>
<div id="view"></div>
</main>
<div id="sum" hidden><div class="tb"><button id="sx">Close</button><button id="sp">Print or save PDF</button></div><div class="paper" id="paper"></div></div>
<div id="info" hidden><div class="card"><h3></h3><p></p><button class="btn" id="ix">Got it</button></div></div>
<script>
var P=function(s){return s.split(";").map(function(x){return x.split("|")})};
var LIB={
warm:"Side Straddle Hops;Imperial Walkers;Windmills;Arm Circles;Butt Kickers;Good Mornings;Cherry Pickers;Slow Squats;Michael Phelps;Toy Soldiers".split(";"),
mary:"LBCs;Flutter Kicks;Plank Hold;American Hammers;Box Cutters;Hello Dollies;Low Slow Flutters;Dying Cockroaches;Crunchy Frogs;Reverse Crunches;Russian Twists;Heels to Heaven".split(";"),
thang:P("Burpees|F;Merkins|U;Squats|L;Walking Lunges|L;Bear Crawls|F;Diamond Merkins|U;Jump Squats|L;Hand Release Merkins|U;Bonnie Blairs|C;Sprints|C;Mountain Climbers|C;Dips|U;High Knees|C;Crab Walks|F;Broad Jumps|L;Duck Walks|L;Wide Merkins|U;Pike Merkins|U;Reverse Lunges|L;Plyo Lunges|L;Star Jumps|C;Decline Merkins|U;Calf Raises|L"),
coupon:P("Curls|U;Overhead Press|U;Goblet Squats|L;Thrusters|F;Coupon Swings|F;Bent Rows|U;Coupon Carry|F;Step-ups|L;Skull Crushers|U;Halos|U")};
var DESC={
"Side Straddle Hops":"Jumping jacks. Jump your feet wide while your arms swing overhead, then jump back together.",
"Imperial Walkers":"Hands behind your head, elbows wide. Raise one knee to touch the opposite elbow, then alternate.",
"Windmills":"Feet wide. Bend at the waist and touch your right hand to your left foot, then switch sides.",
"Arm Circles":"Arms straight out to the sides. Make small circles, then reverse direction halfway.",
"Butt Kickers":"Jog in place, kicking your heels up toward your glutes.",
"Good Mornings":"Hands behind your head, feet shoulder width. Hinge at the hips with a flat back, then stand up.",
"Cherry Pickers":"Feet wide. Bend over and touch the ground by one foot with both hands, then reach high. Alternate sides.",
"Slow Squats":"Squat down for a slow 3 count, then stand up for a slow 3 count.",
"Michael Phelps":"Swing both arms across your chest, then wide open, like a swimmer's warmup.",
"Toy Soldiers":"Walk forward, kicking one straight leg up toward the opposite hand. Alternate legs.",
"LBCs":"Little baby crunches. Lie on your back, hands by your head, feet off the ground, and curl your shoulders up in small crunches.",
"Flutter Kicks":"Lie on your back with legs straight and just off the ground. Kick small and fast, alternating legs.",
"Plank Hold":"Hold a straight-body plank on your hands or forearms with your core tight.",
"American Hammers":"Sit with knees bent and feet up, lean back, and swing clasped hands from side to side.",
"Box Cutters":"On your back with legs raised, open them wide, then cross and close them. Open and close is one rep.",
"Hello Dollies":"On your back with hands under your hips, legs raised. Open the legs wide, then squeeze them together.",
"Low Slow Flutters":"Flutter kicks done slowly with your heels hovering just above the ground.",
"Dying Cockroaches":"On your back with arms and legs in the air like an upside-down bug. Lower the opposite arm and leg, then alternate.",
"Crunchy Frogs":"On your back, hands behind your head, feet together with knees out. Crunch up while pulling your knees in, then extend.",
"Reverse Crunches":"On your back with legs bent. Curl your hips off the ground, knees toward your chest, then lower slowly.",
"Russian Twists":"Sit with knees bent and feet raised, lean back, and twist to tap the ground on each side.",
"Heels to Heaven":"On your back with legs straight up. Lift your hips so your heels reach for the sky, then lower.",
"Burpees":"Squat, put your hands down, kick your feet back to a plank, do a merkin, jump your feet in, and jump up with a clap.",
"Merkins":"Push-ups. Keep your body straight, lower your chest to the ground, and press back up.",
"Squats":"Feet shoulder width. Sit your hips back until your thighs are parallel to the ground, then stand tall.",
"Walking Lunges":"Step forward into a lunge with your back knee near the ground, then step through. Keep moving forward.",
"Bear Crawls":"On hands and feet with your knees off the ground, crawl forward.",
"Diamond Merkins":"Merkins with your hands together under your chest, thumbs and index fingers forming a diamond.",
"Jump Squats":"Squat down, then explode up into a jump and land softly into the next squat.",
"Hand Release Merkins":"Lower your chest to the ground, lift your hands off the floor, then press back up.",
"Bonnie Blairs":"Speed-skater style. Leap side to side, landing on one leg while the other swings behind you.",
"Sprints":"Run as fast as you can to the marker.",
"Mountain Climbers":"In a plank, drive your knees toward your chest one at a time, quickly.",
"Dips":"Hands on a bench or curb behind you. Lower your hips by bending your elbows, then press up.",
"High Knees":"Run in place, driving your knees up to hip height.",
"Crab Walks":"Sit, put your hands behind you, lift your hips, and walk on hands and feet facing up.",
"Broad Jumps":"Swing your arms and jump forward as far as you can, landing softly.",
"Duck Walks":"Stay in a deep squat and waddle forward.",
"Wide Merkins":"Merkins with your hands set wider than your shoulders.",
"Pike Merkins":"Hips high in an inverted V. Bend your elbows to lower your head toward the ground, then press up.",
"Reverse Lunges":"Step one foot back into a lunge, then return to standing. Alternate legs.",
"Plyo Lunges":"Lunge, then jump and switch legs in the air, landing in a lunge on the other side.",
"Star Jumps":"Squat down, then jump up and spread your arms and legs wide like a star.",
"Decline Merkins":"Merkins with your feet up on a bench or curb.",
"Calf Raises":"Rise onto your toes, then lower slowly.",
"Curls":"Hold the coupon at your waist, curl it to your shoulders, then lower slowly.",
"Overhead Press":"Press the coupon from your shoulders to overhead until your arms lock out.",
"Goblet Squats":"Hold the coupon at your chest and squat.",
"Thrusters":"Squat with the coupon at your chest, then stand and press it overhead in one motion.",
"Coupon Swings":"Hinge at the hips and swing the coupon from between your legs up to chest height.",
"Bent Rows":"Hinge forward holding the coupon, pull it to your ribs, then lower.",
"Coupon Carry":"Carry the coupon overhead, at your chest or in one hand for distance.",
"Step-ups":"Step up onto a bench or curb with one foot, bring the other up, then step down.",
"Skull Crushers":"Lie on your back with the coupon above your chest. Bend your elbows to lower it toward your forehead, then extend.",
"Halos":"Circle the coupon around your head, keeping it close, then reverse direction."};
var DIST={"Bear Crawls":1.2,"Walking Lunges":1.2,"Sprints":.4,"Coupon Carry":.8,"Crab Walks":1.2,"Broad Jumps":1.5,"Duck Walks":1.5};
var FOCUS={Full:"",Legs:"L",Upper:"U",Cardio:"C"};
var F=["Rounds","4 Corners","Sevens","Dora 1-2-3","Pyramid","Cindy AMRAP","Tabata"];
var S={tab:"plan",mins:45,coupon:false,mary:true,f1:"Random",f2:"Random",focus:"Full",plan:null};
var T={m:"t",set:300,left:300,run:false,end:0,rep:false,sw:0,swRun:false,swStart:0,laps:[]};
function pick(a){return a[Math.floor(Math.random()*a.length)]}
function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}
function esc(s){var d=document.createElement("div");d.textContent=s;return d.innerHTML}
function pad(n){return n<10?"0"+n:""+n}
function fmt(s){return Math.floor(s/60)+":"+pad(s%60)}
function fsw(ms){var t=Math.floor(ms/100),s=Math.floor(t/10);return Math.floor(s/60)+":"+pad(s%60)+"."+t%10}
function lbl(it){return(it.lab?it.lab+": ":"")+it.n}
function FM(v){return["Random"].concat(F).map(function(x){return'<option'+(x===v?" selected":"")+'>'+x+'</option>'}).join("")}
function thangPool(){var p=LIB.thang.slice();if(S.coupon)p=p.concat(LIB.coupon);var f=FOCUS[S.focus];if(f){var m=p.filter(function(x){return x[1]===f||x[1]==="F"});if(m.length>=5)p=m}return p.map(function(x){return x[0]})}
function reps(sec,nm){if(DIST[nm])return pick(nm==="Sprints"?[40,50,60]:[20,25,30,40])+" yds";if(nm==="Plank Hold")return pick(["30 sec","45 sec","60 sec"]);return sec==="thang"?pick(["x10","x15","x20","x25"]):sec==="warm"?pick(["x15 IC","x20 IC","x25 IC"]):pick(["x20 IC","x25 IC","x30 IC"])}
function secs(key,r,nm){var y=/(\d+) yds/.exec(r);if(y)return y[1]*(DIST[nm]||1)+15;var m=/(\d+) sec/.exec(r);if(m)return +m[1]+10;var n=parseInt(r.slice(1),10);return n*(key==="thang"?3.5:2)+(key==="thang"?15:10)}
function calc(s,target){
var f=s.fmt||"Rounds";s.target=target;s.rounds=1;
if(f==="Dora 1-2-3"){var u=Math.max(10,Math.min(100,Math.round(target/180)*10));s.items.forEach(function(it,i){it.r="x"+u*(i+1)});s.secs=u*18+60}
else if(f==="Sevens"){s.secs=s.items.length/2*400}
else if(f==="Pyramid"){var k=10,tm=function(k){var n=k/5;return 2*(5*n*(n+1)-k)*3.5+(2*n-1)*20};while(k<30&&tm(k)<target)k+=5;var r=[],x;for(x=5;x<=k;x+=5)r.push(x);for(x=k-5;x>=5;x-=5)r.push(x);s.items.forEach(function(it){it.r=r.join("-")});s.secs=tm(k)}
else if(f==="Cindy AMRAP"){s.secs=Math.max(300,Math.round(target/60)*60)}
else if(f==="Tabata"){s.secs=s.items.length*270}
else{var tr=f==="4 Corners"?20:0,one=s.items.reduce(function(a,it){return a+secs(s.key,it.r,it.n)+tr},0)+(s.fmt==="Rounds"?60:0);s.rounds=Math.max(1,Math.min(f==="4 Corners"?4:6,Math.round(target/one)));s.secs=one*s.rounds}
s.mins=Math.max(1,Math.round(s.secs/60));
if(f==="Cindy AMRAP")s.note="AMRAP: as many rounds as possible in "+s.mins+" min. Count your rounds."}
function mkT(title,f,pool,n,target){
var s={key:"thang",title:title,fmt:f,items:[]};
var rp=pool.filter(function(x){return !DIST[x]});if(rp.length<6)rp=pool;
function nm(a){return a.map(function(x){return{n:x,r:reps("thang",x)}})}
function fx(a,lab){a.forEach(function(it,i){it.fixed=true;if(lab)it.lab=lab+(i+1)});return a}
if(f==="4 Corners"){s.items=nm(shuffle(pool).slice(0,4));s.items.forEach(function(it,i){it.lab="Corner "+(i+1)});s.note="Travel between corners: "+pick(["bear crawl","mosey","lunge walk","crab walk","sprint"])+"."}
else if(f==="Sevens"){var np=Math.max(1,Math.min(3,Math.round(target/400),Math.floor(rp.length/2))),a=shuffle(rp).slice(0,np*2);for(var i=0;i<np;i++){s.items.push({n:a[2*i],r:"7 down to 1",lab:"Pair "+(i+1)+", end A",fixed:true},{n:a[2*i+1],r:"1 up to 7",lab:"Pair "+(i+1)+", end B",fixed:true})}s.note="Two lines about 25 yds apart. Do your A reps, run to B, do your B reps, run back. The reps swap every trip."}
else if(f==="Dora 1-2-3"){s.items=fx(nm(shuffle(rp).slice(0,3)),"Exercise ");s.note="Partner up. One partner runs a lap while the other does reps, then swap. Reps go 1x, 2x, 3x."}
else if(f==="Pyramid"){s.items=fx(nm(shuffle(rp).slice(0,2)),"Move ");s.items[0].lab="Move A";s.items[1].lab="Move B";s.note="Do both moves at every rung. Reps climb to the top, then come back down."}
else if(f==="Cindy AMRAP"){s.items=fx(nm(shuffle(rp).slice(0,3)));s.items.forEach(function(it,i){it.r="x"+5*(i+1)})}
else if(f==="Tabata"){var nb=Math.max(1,Math.min(4,Math.round(target/270)));shuffle(rp).slice(0,nb).forEach(function(x,i){s.items.push({n:x,r:"20 sec on, 10 off x8",lab:"Block "+(i+1),fixed:true})});s.note="Each block is 4 minutes: 20 seconds of work, 10 seconds of rest, 8 times."}
else{s.fmt="Rounds";s.items=nm(shuffle(pool).slice(0,n));s.note="After every round, everyone runs a lap."}
calc(s,target);return s}
function gen(){
var m=S.mins,nT=m>=60?5:4,nW=m>=60?5:4,nM=m>=45?4:3,tp=S.mary?.33:.43;
function mk(key,title,pool,n,share){var s={key:key,title:title,items:shuffle(pool).slice(0,n).map(function(x){return{n:x,r:reps(key,x)}})};calc(s,m*60*share);return s}
function fm(v){return v==="Random"?pick(F):v}
var f1=fm(S.f1),f2=fm(S.f2);if(S.f1==="Random"&&S.f2==="Random"&&f1===f2)f2=pick(F.filter(function(x){return x!==f1}));
var t1=mkT("Thang 1",f1,thangPool(),nT,m*60*(tp-.01)),used=t1.items.map(function(x){return x.n}),p2=thangPool().filter(function(x){return used.indexOf(x)<0});if(p2.length<6)p2=thangPool();
S.plan=[mk("warm","Warm-o-rama",LIB.warm,nW,.15),t1,mkT("Thang 2",f2,p2,nT,m*60*tp)];
if(S.mary)S.plan.push(mk("mary","Mary",LIB.mary,nM,.2));draw()}
function head(s){return(s.fmt&&s.fmt!=="Rounds"?s.fmt+", ":"")+(s.rounds>1?s.rounds+(s.fmt==="4 Corners"?" laps, ":" rounds, "):"")+"about "+s.mins+" min"}
function viewPlan(){
var h='<div class="row"><div><label for="mins">Length</label><select id="mins">'+[30,45,60].map(function(m){return'<option value="'+m+'"'+(m===S.mins?" selected":"")+'>'+m+' minutes</option>'}).join("")+'</select></div><div><label for="foc">Focus</label><select id="foc">'+Object.keys(FOCUS).map(function(k){return'<option'+(k===S.focus?" selected":"")+'>'+k+'</option>'}).join("")+'</select></div></div>'+
'<div class="row"><div><label for="f1">Thang 1 format</label><select id="f1">'+FM(S.f1)+'</select></div><div><label for="f2">Thang 2 format</label><select id="f2">'+FM(S.f2)+'</select></div></div>'+
'<label><input type="checkbox" id="cp" style="width:auto;margin-right:8px"'+(S.coupon?" checked":"")+'>Bring coupons (blocks)</label>'+
'<label><input type="checkbox" id="my" style="width:auto;margin-right:8px"'+(S.mary?" checked":"")+'>Include Mary</label>'+
'<div class="row"><button class="btn" id="gen">'+(S.plan?"Rebuild":"Build the beatdown")+'</button>'+(S.plan?'<button class="btn alt" id="sm">One-page summary</button>':'')+'</div>';
if(!S.plan)return h+'<p class="empty">Pick a length and focus, then build. Tap i on any move to see how it is done.</p>';
S.plan.forEach(function(s,si){h+='<section class="sec"><h2>'+s.title+' <small>'+head(s)+'</small></h2>'+(s.note?'<p class="sub" style="margin:0 0 6px">'+esc(s.note)+'</p>':'');
s.items.forEach(function(it,ii){h+='<div class="ex"><span>'+esc(lbl(it))+' <em>'+it.r+'</em></span><button data-in="'+esc(it.n)+'" aria-label="How to do '+esc(it.n)+'">i</button><button data-sw="'+si+','+ii+'" aria-label="Swap '+esc(it.n)+'">&#8635;</button>'+(s.fmt&&s.fmt!=="Rounds"?"":'<button data-rm="'+si+','+ii+'" aria-label="Remove '+esc(it.n)+'">&#10005;</button>')+'</div>'});h+='</section>'});
return h}
function showInfo(n){var m=document.getElementById("info");m.querySelector("h3").textContent=n;m.querySelector("p").textContent=DESC[n]||"No description yet.";m.hidden=false}
function showSum(){
var d=new Date().toLocaleDateString(undefined,{weekday:"long",month:"long",day:"numeric"}),tot=S.plan.reduce(function(a,s){return a+s.mins},0),h='<h1>F3 Beatdown</h1><p>'+d+'. About '+tot+' min'+(S.coupon?', coupons':'')+'.</p>';
S.plan.forEach(function(s){h+='<h2>'+s.title+' <small>'+head(s)+'</small></h2>'+(s.note?'<p><em>'+esc(s.note)+'</em></p>':'')+'<ul>'+s.items.map(function(it){return'<li>'+esc(lbl(it))+', '+it.r+'</li>'}).join("")+'</ul>'});
document.getElementById("paper").innerHTML=h;document.getElementById("sum").hidden=false}
function bindPlan(){
function $(i){return document.getElementById(i)}
$("mins").onchange=function(e){S.mins=+e.target.value};$("foc").onchange=function(e){S.focus=e.target.value};
$("f1").onchange=function(e){S.f1=e.target.value};$("f2").onchange=function(e){S.f2=e.target.value};
$("cp").onchange=function(e){S.coupon=e.target.checked};$("my").onchange=function(e){S.mary=e.target.checked};
$("gen").onclick=gen;var sm=$("sm");if(sm)sm.onclick=showSum;
document.querySelectorAll("[data-in]").forEach(function(b){b.onclick=function(){showInfo(b.dataset.in)}});
document.querySelectorAll("[data-sw]").forEach(function(b){b.onclick=function(){var p=b.dataset.sw.split(","),s=S.plan[p[0]],used=s.items.map(function(x){return x.n});var pool=(s.key==="thang"?thangPool():LIB[s.key]).filter(function(x){return used.indexOf(x)<0&&!(s.fmt&&s.fmt!=="Rounds"&&s.fmt!=="4 Corners"&&DIST[x])});if(pool.length){var it=s.items[p[1]];it.n=pick(pool);if(!it.fixed)it.r=reps(s.key,it.n);calc(s,s.target)}draw()}});
document.querySelectorAll("[data-rm]").forEach(function(b){b.onclick=function(){var p=b.dataset.rm.split(","),s=S.plan[p[0]];if(s.items.length>1){s.items.splice(p[1],1);calc(s,s.target)}draw()}});
}
function viewTimer(){
var h='<div class="chips"><button class="chip" id="mt" aria-pressed="'+(T.m==="t")+'">Timer</button><button class="chip" id="ms" aria-pressed="'+(T.m==="s")+'">Stopwatch</button></div><div class="run"><div class="clock" id="clk">'+(T.m==="t"?fmt(T.left):fsw(T.sw))+'</div></div>';
if(T.m==="t")h+='<div class="row"><div><label for="tmn">Minutes</label><input id="tmn" type="number" min="0" max="180" inputmode="numeric" value="'+Math.floor(T.set/60)+'"></div><div><label for="tsc">Seconds</label><input id="tsc" type="number" min="0" max="59" inputmode="numeric" value="'+T.set%60+'"></div></div><div class="chips">'+[30,60,120,300,600].map(function(x){return'<button class="chip" data-ps="'+x+'">'+fmt(x)+'</button>'}).join("")+'</div><button class="btn" id="tgo">'+(T.run?"Pause":"Start")+'</button><div class="row"><button class="btn alt" id="trs">Reset</button><button class="btn alt" id="trp" aria-pressed="'+T.rep+'">Repeat: '+(T.rep?"On":"Off")+'</button></div>';
else h+='<button class="btn" id="sgo">'+(T.swRun?"Stop":"Start")+'</button><div class="row"><button class="btn alt" id="slp">Lap</button><button class="btn alt" id="srs">Reset</button></div><ol>'+T.laps.map(function(l){return'<li>'+l+'</li>'}).join("")+'</ol>';
return h}
function bindTimer(){
function $(i){return document.getElementById(i)}
$("mt").onclick=function(){T.m="t";draw()};$("ms").onclick=function(){T.m="s";draw()};
if(T.m==="t"){
function setT(v){T.set=v;if(!T.run)T.left=v}
function rd(){setT((+$("tmn").value||0)*60+Math.min(59,+$("tsc").value||0));$("clk").textContent=fmt(T.left)}
$("tmn").oninput=rd;$("tsc").oninput=rd;
document.querySelectorAll("[data-ps]").forEach(function(b){b.onclick=function(){setT(+b.dataset.ps);draw()}});
$("tgo").onclick=function(){if(T.run){T.run=false}else{if(T.left<=0)T.left=T.set;if(T.left>0){T.end=Date.now()+T.left*1000;T.run=true}}draw()};
$("trs").onclick=function(){T.run=false;T.left=T.set;draw()};
$("trp").onclick=function(){T.rep=!T.rep;draw()};
}else{
$("sgo").onclick=function(){if(T.swRun){T.swRun=false}else{T.swStart=Date.now()-T.sw;T.swRun=true}draw()};
$("slp").onclick=function(){if(T.sw>0){T.laps.unshift(fsw(T.sw));draw()}};
$("srs").onclick=function(){T.sw=0;T.swRun=false;T.laps=[];draw()};
}}
function beep(){try{var a=new(window.AudioContext||window.webkitAudioContext)(),o=a.createOscillator();o.connect(a.destination);o.frequency.value=880;o.start();setTimeout(function(){o.stop();a.close()},500)}catch(e){}try{navigator.vibrate&&navigator.vibrate([300,150,300])}catch(e){}}
setInterval(function(){var c=document.getElementById("clk");
if(T.run){var l=Math.ceil((T.end-Date.now())/1000);if(l<=0){beep();if(T.rep){T.end=Date.now()+T.set*1000;l=T.set}else{T.run=false;l=0;T.left=0;draw()}}T.left=l;if(c&&T.m==="t")c.textContent=fmt(l)}
if(T.swRun){T.sw=Date.now()-T.swStart;if(c&&T.m==="s")c.textContent=fsw(T.sw)}},100);
function setTab(t){S.tab=t;["plan","timer","dir"].forEach(function(k){document.getElementById("t-"+k).setAttribute("aria-selected",k===t)});draw()}
["plan","timer","dir"].forEach(function(k){document.getElementById("t-"+k).onclick=function(){setTab(k)}});
document.getElementById("sx").onclick=function(){document.getElementById("sum").hidden=true};
document.getElementById("sp").onclick=function(){try{window.print()}catch(e){}};
document.getElementById("ix").onclick=function(){document.getElementById("info").hidden=true};
document.getElementById("info").onclick=function(e){if(e.target===this)this.hidden=true};
function dirList(q){q=q.toLowerCase();var g=[["Warm-up",LIB.warm],["Thang",LIB.thang.map(function(x){return x[0]})],["Thang with a coupon",LIB.coupon.map(function(x){return x[0]})],["Mary",LIB.mary]],h="";
g.forEach(function(x){var l=x[1].slice().sort().filter(function(n){return !q||n.toLowerCase().indexOf(q)>-1||(DESC[n]||"").toLowerCase().indexOf(q)>-1});if(l.length){h+='<section class="sec"><h2>'+x[0]+'</h2>'+l.map(function(n){return'<div class="ex" style="display:block"><b>'+esc(n)+'</b><div class="sub" style="margin:2px 0 0">'+esc(DESC[n]||"")+'</div></div>'}).join("")+'</section>'}});
return h||'<p class="empty">No moves match.</p>'}
function viewDir(){return'<label for="dq">Search moves</label><input id="dq" type="search" placeholder="Name or description"><div id="dl">'+dirList("")+'</div>'}
function bindDir(){document.getElementById("dq").oninput=function(e){document.getElementById("dl").innerHTML=dirList(e.target.value)}}
function draw(){var v=document.getElementById("view");if(S.tab==="dir"){v.innerHTML=viewDir();bindDir();return}if(S.tab==="timer"){v.innerHTML=viewTimer();bindTimer()}else{v.innerHTML=viewPlan();bindPlan()}}
draw();
</script>
</body>
</html>
